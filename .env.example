# Firebase Functions configuration.
# Store these two values in Secret Manager with:
# firebase functions:secrets:set PORTALY_API_KEY --project ufogeo-adac7
# firebase functions:secrets:set PORTALY_CALLBACK_SECRET --project ufogeo-adac7
# Never commit the actual secret values or copy them into the iOS app.
PORTALY_API_KEY=
PORTALY_CALLBACK_SECRET=

# Optional Functions runtime override; the code defaults to https://portaly.ai.
PORTALY_API_HOST=
